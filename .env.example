# DriveSafe Application Secrets
SECRET_KEY=replace-with-a-long-random-secret-key-for-flask-sessions
COOKIE_SECURE=false
PORT=5000

# Twilio SMS API Credentials (Required for Mobile SMS Alerts)
# Sign up at https://www.twilio.com/ and obtain credentials from your Twilio Console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Eye detection tuning (defaults shown)
EYE_CLOSED_THRESHOLD=0.22
EYE_OPEN_THRESHOLD=0.26
EYE_CLOSED_CONFIRM_FRAMES=2
BLINK_MIN_DURATION=0.08
BLINK_MAX_DURATION=0.80
DROWSINESS_TIME=2.0

